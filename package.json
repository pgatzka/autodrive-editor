{
  "name": "autodrive-editor",
  "version": "0.1.0",
  "description": "Desktop route network editor for the FS25 AutoDrive mod",
  "author": "Phil Gatzka",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pgatzka/autodrive-editor.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "test": "node tests/model.test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.49.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "dev.pgatzka.autodrive-editor",
    "productName": "AutoDrive Editor",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "pgatzka",
      "repo": "autodrive-editor",
      "releaseType": "draft"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
